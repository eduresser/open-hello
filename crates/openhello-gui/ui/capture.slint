import { Palette, Spinner } from "std-widgets.slint";
import { ActionButton, Body, Brand, Footer, Heading, Spacer } from "components.slint";
import { T } from "texts.slint";

component Preview inherits Rectangle {
    in property <image> frame;
    in property <bool> accepted;
    in property <bool> saving;

    property <length> vw: 560px;
    property <length> vh: 315px;
    property <length> cx: vw / 2;
    property <length> cy: vh / 2;
    property <length> orx: 76px;
    property <length> ory: 97.5px;
    property <string> oval: "M \{cx / 1px} \{cy / 1px - ory / 1px} A \{orx / 1px} \{ory / 1px} 0 1 1 \{cx / 1px} \{cy / 1px + ory / 1px} A \{orx / 1px} \{ory / 1px} 0 1 1 \{cx / 1px} \{cy / 1px - ory / 1px} Z";

    width: vw;
    height: vh;
    border-radius: 8px;
    background: #000000;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: cover;
        transform-scale-x: -1;
    }

    Rectangle {
        background: #000000;
        opacity: root.saving ? 0.55 : 0;
        animate opacity { duration: 320ms; easing: ease-out; }
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.vw / 1px;
        viewbox-height: root.vh / 1px;
        fill: #000000a0;
        fill-rule: evenodd;
        commands: "M 0 0 L \{root.vw / 1px} 0 L \{root.vw / 1px} \{root.vh / 1px} L 0 \{root.vh / 1px} Z " + root.oval;
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.vw / 1px;
        viewbox-height: root.vh / 1px;
        stroke: root.accepted || root.saving ? Brand.accepted : #ffffffd0;
        stroke-width: 3px;
        animate stroke { duration: 250ms; }
        commands: root.oval;
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress;

    height: 4px;
    border-radius: 2px;
    background: Palette.foreground.with-alpha(0.12);
    accessible-role: progress-indicator;
    accessible-value: round(root.progress * 100) + "%";

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: Brand.accent;
        animate width { duration: 200ms; easing: ease-out; }
    }
}

export component CapturePage inherits VerticalLayout {
    in property <image> frame;
    in property <string> guidance;
    in property <float> progress;
    in property <bool> accepted;
    in property <bool> saving;
    in property <bool> busy;
    callback cancel();

    VerticalLayout {
        alignment: center;
        vertical-stretch: 1;
        padding: 24px;
        spacing: 16px;

        Heading { text: root.saving ? T.saving : T.capture-title; }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 12px;
                Preview {
                    frame: root.frame;
                    accepted: root.accepted;
                    saving: root.saving;
                }
                ProgressBar { progress: root.saving ? 1 : root.progress; }
            }
        }

        if !root.saving: Text {
            text: root.guidance;
            font-size: 17px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: center;
            wrap: word-wrap;
            min-height: 44px;
        }

        if root.saving: HorizontalLayout {
            alignment: center;
            spacing: 10px;
            min-height: 44px;
            VerticalLayout {
                alignment: center;
                Spinner {
                    indeterminate: true;
                    width: 20px;
                    height: 20px;
                }
            }
            Body {
                text: T.saving-body;
                vertical-alignment: center;
            }
        }
    }
    Footer {
        Spacer {}
        ActionButton {
            text: T.cancel;
            secondary: true;
            enabled: !root.busy;
            clicked => { root.cancel(); }
        }
    }
}

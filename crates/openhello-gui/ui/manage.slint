import { ActionButton, Brand, Column, Footer, Intro, SudoNotice, LinkButton, MarkRow, Spacer, TestStatus } from "components.slint";
import { T } from "texts.slint";

export component ManagePage inherits VerticalLayout {
    in property <bool> busy;
    in property <bool> testing;
    in property <string> result;
    in property <bool> blocked;
    in property <string> blocked-title;
    in property <string> blocked-body;
    in-out property <bool> confirming;
    in property <bool> sudo-asks-root;
    in property <string> sudo-message;
    callback test();
    callback use-own-sudo();
    callback set-up-again();

    property <bool> usable: !root.busy && !root.confirming && !root.blocked;

    Column {
        TestStatus {
            busy: root.busy;
            testing: root.testing;
            result: root.result;
        }
        MarkRow {
            fill: root.blocked ? Brand.muted : Brand.positive;
            troubled: root.blocked;
        }
        Intro {
            title: root.blocked ? root.blocked-title : T.window-title;
            body: root.blocked ? root.blocked-body : T.manage-body;
        }
        SudoNotice {
            asks-root: root.sudo-asks-root && !root.blocked;
            message: root.sudo-message;
            enabled: root.usable;
            use-own => { root.use-own-sudo(); }
        }
    }
    Footer {
        LinkButton {
            text: T.delete-data;
            clicked => {
                if (!root.busy) {
                    root.confirming = true;
                }
            }
        }
        Spacer {}
        ActionButton {
            text: T.test;
            enabled: root.usable;
            clicked => { root.test(); }
        }
        ActionButton {
            text: T.set-up-again;
            secondary: true;
            enabled: root.usable;
            clicked => { root.set-up-again(); }
        }
    }
}

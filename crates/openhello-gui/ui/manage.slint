import { Button } from "std-widgets.slint";
import { ActionButton, Body, ButtonRow, Column, Heading, LinkButton, TestStatus } from "components.slint";
import { T } from "texts.slint";

export component ManagePage inherits Rectangle {
    in property <bool> busy;
    in property <bool> testing;
    in property <string> result;
    in property <bool> blocked;
    in property <string> blocked-title;
    in property <string> blocked-body;
    in-out property <bool> confirming;
    callback test();
    callback set-up-again();

    property <bool> usable: !root.busy && !root.confirming && !root.blocked;

    Column {
        TestStatus {
            busy: root.busy;
            testing: root.testing;
            result: root.result;
        }
        Heading { text: root.blocked ? root.blocked-title : T.window-title; }
        Body { text: root.blocked ? root.blocked-body : T.manage-body; }
        ButtonRow {
            ActionButton {
                text: T.test;
                enabled: root.usable;
                clicked => { root.test(); }
            }
            Button {
                text: T.set-up-again;
                enabled: root.usable;
                clicked => { root.set-up-again(); }
            }
        }
        ButtonRow {
            LinkButton {
                text: T.delete-data;
                clicked => {
                    if (!root.busy) {
                        root.confirming = true;
                    }
                }
            }
        }
    }
}

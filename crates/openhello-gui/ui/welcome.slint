import { ActionButton, Brand, Column, Footer, Intro, MarkRow, Spacer } from "components.slint";
import { T } from "texts.slint";

export component WelcomePage inherits VerticalLayout {
    in property <bool> blocked;
    in property <bool> busy;
    in property <string> blocked-title;
    in property <string> blocked-body;
    callback get-started();
    callback retry();

    Column {
        MarkRow {
            fill: root.blocked ? Brand.muted : Brand.logo;
            troubled: root.blocked;
        }
        Intro {
            title: root.blocked ? root.blocked-title : T.welcome-title;
            body: root.blocked ? root.blocked-body : T.welcome-body;
        }
    }
    Footer {
        Spacer {}
        ActionButton {
            text: T.set-up;
            enabled: !root.blocked && !root.busy;
            clicked => { root.get-started(); }
        }
        if root.blocked: ActionButton {
            text: T.try-again;
            secondary: true;
            enabled: !root.busy;
            clicked => { root.retry(); }
        }
    }
}

import { ActionButton, Brand, Column, Footer, Intro, SudoNotice, MarkRow, Spacer, TestStatus } from "components.slint";
import { T } from "texts.slint";

export component DonePage inherits VerticalLayout {
    in property <bool> busy;
    in property <bool> testing;
    in property <bool> sudo-asks-root;
    in property <string> sudo-message;
    callback test();
    callback use-own-sudo();
    callback set-up-again();

    Column {
        MarkRow { fill: Brand.positive; }
        Intro {
            title: T.done-title;
            body: T.done-body;
        }
        TestStatus {
            busy: root.busy;
            testing: root.testing;
        }
        SudoNotice {
            asks-root: root.sudo-asks-root;
            message: root.sudo-message;
            enabled: !root.busy;
            use-own => { root.use-own-sudo(); }
        }
    }
    Footer {
        Spacer {}
        ActionButton {
            text: T.test;
            enabled: !root.busy;
            clicked => { root.test(); }
        }
        ActionButton {
            text: T.set-up-again;
            secondary: true;
            enabled: !root.busy;
            clicked => { root.set-up-again(); }
        }
    }
}

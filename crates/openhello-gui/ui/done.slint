import { ActionButton, AdminSwitch, Brand, Column, Footer, Intro, MarkRow, Spacer, TestStatus, Tone } from "components.slint";
import { T } from "texts.slint";

export component DonePage inherits VerticalLayout {
    in property <bool> busy;
    in property <bool> testing;
    in property <bool> sudo-asks-root;
    in property <bool> sudo-switched;
    in property <string> sudo-message;
    in property <Tone> sudo-tone;
    callback test();
    callback use-own-sudo();
    callback restore-root-sudo();
    callback set-up-again();

    Column {
        MarkRow { fill: Brand.positive; }
        Intro {
            title: T.done-title;
            body: T.done-body;
        }
        TestStatus {
            busy: root.busy;
            testing: root.testing;
        }
        AdminSwitch {
            shown: root.sudo-asks-root || root.sudo-switched;
            on: root.sudo-switched;
            enabled: !root.busy;
            message: root.sudo-message;
            tone: root.sudo-tone;
            turn-on => { root.use-own-sudo(); }
            turn-off => { root.restore-root-sudo(); }
        }
    }
    Footer {
        Spacer {}
        ActionButton {
            text: T.test;
            enabled: !root.busy;
            clicked => { root.test(); }
        }
        ActionButton {
            text: T.set-up-again;
            secondary: true;
            enabled: !root.busy;
            clicked => { root.set-up-again(); }
        }
    }
}

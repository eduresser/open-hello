import { Palette } from "std-widgets.slint";
import { ActionButton, Brand, ButtonRow } from "components.slint";
import { T } from "texts.slint";

export component ConfirmRemoval inherits Rectangle {
    callback confirmed();
    callback dismissed();

    background: #00000099;

    TouchArea {}

    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: min(440px, root.width - 48px);
                background: Palette.background;
                border-radius: 12px;
                border-width: 1px;
                border-color: Palette.foreground.with-alpha(0.12);
                drop-shadow-offset-y: 12px;
                drop-shadow-blur: 32px;
                drop-shadow-color: #00000066;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: T.delete-confirm-title;
                        font-size: 20px;
                        font-weight: 700;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                    Text {
                        text: T.delete-confirm-body;
                        font-size: 15px;
                        color: Palette.foreground.with-alpha(0.78);
                        wrap: word-wrap;
                    }
                    ButtonRow {
                        alignment: end;
                        padding-top: 12px;
                        ActionButton {
                            text: T.delete;
                            tone: Brand.danger;
                            clicked => { root.confirmed(); }
                        }
                        ActionButton {
                            text: T.cancel;
                            secondary: true;
                            clicked => { root.dismissed(); }
                        }
                    }
                }
            }
        }
    }

    init => { scope.focus(); }
}

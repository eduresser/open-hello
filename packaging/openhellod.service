[Unit]
Description=open-hello biometric daemon
After=dbus.service tpm2.target
ConditionPathExists=/etc/openhello/engine.json

[Service]
Type=simple
EnvironmentFile=/etc/openhello/openhello.env
ExecStart=@LIBEXECDIR@/openhellod \
  --sensor-lib /usr/lib/openhello/libsensor_adapter_ir.so \
  --engine-lib /usr/lib/openhello/libengine_adapter_face.so \
  --storage-lib /usr/lib/openhello/libstorage_adapter_templates.so \
  --device ${OPENHELLO_DEVICE} \
  --state-dir /var/lib/openhello \
  --engine-config /etc/openhello/engine.json
Restart=on-failure
StateDirectory=openhello
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target

[Unit]
Description=open-hello key daemon (TPM login key and protectors)
After=dbus.service tpm2.target
Before=openhellod.service

[Service]
Type=simple
Environment=OPENHELLO_KEYD_STORE_DIR=/var/lib/openhello-keyd
Environment=OPENHELLO_KEYD_TCTI=device:/dev/tpmrm0
Environment=OPENHELLO_KEYD_TICKET_SOCKET=/run/openhello/keyd-ticket.sock
Environment=OPENHELLO_KEYD_UNLOCK_SOCKET=/run/openhello/keyd-unlock.sock
Environment=OPENHELLO_KEYD_TICKET_EXE=/usr/libexec/openhello/openhellod
EnvironmentFile=-/etc/openhello/openhello-keyd.env
ExecStart=/usr/libexec/openhello/openhello-keyd
Restart=on-failure
StateDirectory=openhello-keyd
StateDirectoryMode=0700
RuntimeDirectory=openhello
RuntimeDirectoryMode=0755
UMask=0077

CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
